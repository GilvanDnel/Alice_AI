# ==========================================================
# Daniel AI - Variáveis de Ambiente
# ==========================================================

# Provedor ativo de IA: 'ollama' (recomendado, local) ou 'gemini' (nuvem)
LLM_PROVIDER=ollama

# Configuração Ollama (100% Local, sem necessidade de internet)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=90

# Configuração Gemini (Opcional - só preencha se LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Parâmetros de Recuperação do RAG
RAG_N_RESULTS=4
RAG_MAX_DISTANCE=0.60

# Painel Administrativo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Daniel@2026
